# Built application files
*.apk
*.aab
*.ap_
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Android Studio / IntelliJ
*.iml
.idea/
*.ipr
*.iws
.navigation/
captures/

# Keystore files
*.jks
*.keystore

# Signing secrets (store/key passwords) — never commit
signing.properties

# Debug / release outputs we intentionally keep at repo root are ignored by pattern above;
# CI re-builds them. Keep tooling scripts though.
!tools/

# OS-specific files
.DS_Store
Thumbs.db

# NDK
obj/

# Logs
*.log
