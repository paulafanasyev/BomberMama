<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Основной тёплый градиент -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4A7A5E"
                android:centerColor="#3A5F4E"
                android:endColor="#22402F"
                android:angle="270" />
        </shape>
    </item>
    <!-- Декоративная рамка по периметру (pixel-art стиль) -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="12dp" android:color="#FFE066" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#E0557A" />
        </shape>
    </item>
</layer-list>
