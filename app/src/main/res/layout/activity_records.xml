<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@drawable/bg_menu">

    <TextView
        style="@style/TextAppearance.BomberMama.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/records_title"
        android:textSize="36sp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:background="@drawable/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginBottom="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/records_best"
            android:textColor="@color/ui_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvBestScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_gold"
            android:textSize="40sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:background="@drawable/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/records_levels"
            android:textColor="@color/ui_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLevelsCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_green"
            android:textSize="28sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/btnReset"
        style="@style/TextAppearance.BomberMama.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="14dp"
        android:textSize="16sp"
        android:background="@drawable/btn_primary"
        android:text="@string/records_reset" />

    <Button
        android:id="@+id/btnBack"
        style="@style/TextAppearance.BomberMama.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="14dp"
        android:textSize="16sp"
        android:background="@drawable/btn_secondary"
        android:text="@string/levels_back" />

</LinearLayout>
