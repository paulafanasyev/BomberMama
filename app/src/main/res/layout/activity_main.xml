<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_menu">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:src="@drawable/logo_banner"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="12dp"
        android:layout_weight="0" />

    <TextView
        android:id="@+id/title"
        style="@style/TextAppearance.BomberMama.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_title"
        android:textSize="48sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_subtitle"
        android:textColor="@color/ui_text_light"
        android:textSize="14sp"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btnNewGame"
        style="@style/TextAppearance.BomberMama.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:padding="14dp"
        android:textSize="18sp"
        android:background="@drawable/btn_primary"
        android:text="@string/menu_new_game" />

    <Button
        android:id="@+id/btnLevels"
        style="@style/TextAppearance.BomberMama.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:padding="14dp"
        android:textSize="18sp"
        android:background="@drawable/btn_secondary"
        android:text="@string/menu_levels" />

    <Button
        android:id="@+id/btnRecords"
        style="@style/TextAppearance.BomberMama.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:padding="14dp"
        android:textSize="18sp"
        android:background="@drawable/btn_secondary"
        android:text="@string/menu_records" />

    <Button
        android:id="@+id/btnSettings"
        style="@style/TextAppearance.BomberMama.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:padding="14dp"
        android:textSize="18sp"
        android:background="@drawable/btn_secondary"
        android:text="@string/menu_settings" />

    <Button
        android:id="@+id/btnHelp"
        style="@style/TextAppearance.BomberMama.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:padding="14dp"
        android:textSize="18sp"
        android:background="@drawable/btn_secondary"
        android:text="@string/menu_help" />

    <Button
        android:id="@+id/btnExit"
        style="@style/TextAppearance.BomberMama.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:textSize="18sp"
        android:background="@drawable/btn_secondary"
        android:text="@string/menu_exit" />

</LinearLayout>
