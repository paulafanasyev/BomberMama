<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/TextAppearance.BomberMama.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_title"
            android:textSize="32sp"
            android:layout_gravity="center"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_goal_title"
            android:textColor="@color/ui_gold"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_goal"
            android:textColor="@color/ui_text"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_controls_title"
            android:textColor="@color/ui_gold"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_controls"
            android:textColor="@color/ui_text"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_bonuses_title"
            android:textColor="@color/ui_gold"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_bonuses"
            android:textColor="@color/ui_text"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_enemies_title"
            android:textColor="@color/ui_gold"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_enemies"
            android:textColor="@color/ui_text"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnBack"
            style="@style/TextAppearance.BomberMama.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textSize="16sp"
            android:background="@drawable/btn_secondary"
            android:text="@string/help_back" />

    </LinearLayout>

</ScrollView>
